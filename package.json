{
  "name": "odak-desktop",
  "version": "1.1.1",
  "description": "Ders çalışma sayacı ve günlük çalışma günlüğü",
  "author": "Odak",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5186 --strictPort",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "npm run typecheck && vite build && node scripts/build-electron.mjs",
    "desktop": "electron .",
    "package": "npm run build && electron-builder --win portable --x64 --config.electronDist=node_modules/electron/dist",
    "package:dir": "npm run build && electron-builder --win --x64 --dir --config.electronDist=node_modules/electron/dist",
    "format": "prettier --write src electron tests scripts/*.mjs vite.config.ts package.json README.md",
    "format:check": "prettier --check src electron tests scripts/*.mjs vite.config.ts package.json README.md"
  },
  "devDependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@fontsource/dm-mono": "^5.3.0",
    "@mui/icons-material": "^9.5.0",
    "@mui/material": "^9.5.0",
    "@tailwindcss/vite": "^4.2.0",
    "@types/node": "^22.19.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "44.9.0",
    "electron-builder": "26.15.3",
    "esbuild": "^0.25.0",
    "prettier": "3.6.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "^4.2.0",
    "typescript": "^5.9.0",
    "vite": "^7.3.7",
    "vitest": "^5.0.5"
  },
  "build": {
    "appId": "com.odak.study",
    "productName": "Odak",
    "directories": {
      "output": "release/1.1.1",
      "buildResources": "resources"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "resources/icon.png",
      "package.json",
      "!node_modules/**/*"
    ],
    "npmRebuild": false,
    "asar": true,
    "win": {
      "target": "portable",
      "icon": "resources/icon.ico",
      "signAndEditExecutable": false
    },
    "portable": {
      "artifactName": "Odak-${version}.exe"
    }
  }
}
